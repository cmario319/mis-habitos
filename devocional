  ctx.font = '26px Inter, sans-serif';
  ctx.fillText(day.title, W/2, 870);

  canvas.toBlob(blob=>{
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url; a.download = `capsula-${day.title.toLowerCase().replace(/\s+/g,'-')}.png`;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(()=>URL.revokeObjectURL(url), 2000);
    showToast('Imagen descargada 📤');
  });
}
function wrapText(ctx, text, x, y, maxWidth, lineHeight){
  const words = text.split(' ');
  let line = ''; let lines = [];
  words.forEach(word=>{
    const test = line + word + ' ';
    if(ctx.measureText(test).width > maxWidth && line !== ''){ lines.push(line); line = word + ' '; }
    else { line = test; }
  });
  lines.push(line);
  const startY = y - (lines.length-1)*lineHeight/2;
  lines.forEach((l,i)=> ctx.fillText(l.trim(), x, startY + i*lineHeight));
}

/* ---------- Backup ---------- */
function exportBackup(){
  const blob = new Blob([JSON.stringify(state, null, 2)], {type:'application/json'});
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url; a.download = `capsulas-respaldo-${todayKey()}.json`;
  document.body.appendChild(a); a.click(); document.body.removeChild(a);
  setTimeout(()=>URL.revokeObjectURL(url), 2000);
  showToast('Copia exportada');
}
let pendingImport = null;
function handleImportFile(e){
  const file = e.target.files[0];
  if(!file) return;
  const reader = new FileReader();
  reader.onload = ev=>{
    try{
      const parsed = JSON.parse(ev.target.result);
      if(!parsed.progress){ throw new Error('formato inválido'); }
      pendingImport = parsed;
      document.getElementById('importModal').classList.add('show');
    } catch(err){ showToast('El archivo no es una copia válida'); }
  };
  reader.readAsText(file);
  e.target.value = '';
}
document.getElementById('importCancel').addEventListener('click', ()=>{ pendingImport=null; document.getElementById('importModal').classList.remove('show'); });
document.getElementById('importConfirm').addEventListener('click', ()=>{
  if(!pendingImport) return;
  state.progress = pendingImport.progress || {};
  state.favorites = pendingImport.favorites || [];
  state.settings = Object.assign({dark:false, onboarded:true}, pendingImport.settings || {});
  state.lastOpened = pendingImport.lastOpened || null;
  saveState(); applyTheme(); render();
  document.getElementById('importModal').classList.remove('show');
  pendingImport = null;
  showToast('Copia restaurada ✓');
});

loadState();
</script>
