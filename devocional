const STORAGE_KEY = 'capsulas-state';

let state = { progress:{}, favorites:[], settings:{dark:false, onboarded:false}, lastOpened:null };
let view = {type:'home'};

function pad(n){ return n.toString().padStart(2,'0'); }
function dateKey(d){ return `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}`; }
function todayKey(){ return dateKey(new Date()); }
function dayId(m,w,d){ return `m${m}-w${w}-d${d}`; }
function getDay(m,w,d){ return PILLARS[m].weeks[w].days[d]; }
function showToast(msg, celebrate){
  const t = document.getElementById('toast');
  t.textContent = msg; t.classList.toggle('celebrate', !!celebrate); t.classList.add('show');
  clearTimeout(showToast._h);
  showToast._h = setTimeout(()=>t.classList.remove('show'), celebrate?2400:1600);
}

function loadState(){
  try{
    const raw = localStorage.getItem(STORAGE_KEY);
    if(raw){
      const parsed = JSON.parse(raw);
      state.progress = parsed.progress || {};
      state.favorites = parsed.favorites || [];
      state.settings = Object.assign({dark:false, onboarded:false}, parsed.settings || {});
      state.lastOpened = parsed.lastOpened || null;
    }
  } catch(e){ console.error('No se pudo leer', e); }
  applyTheme();
  render();
  if(!state.settings.onboarded){ document.getElementById('onboardModal').classList.add('show'); }
}
function saveState(){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(state)); }
  catch(e){ console.error('No se pudo guardar', e); showToast('No se pudo guardar'); }
}
function applyTheme(){ document.body.classList.toggle('dark', !!state.settings.dark); }

document.getElementById('onboardClose').addEventListener('click', ()=>{
  state.settings.onboarded = true; saveState();
  document.getElementById('onboardModal').classList.remove('show');
});

/* ---------- Streak ---------- */
function completedDatesSet(){
  const s = new Set();
  Object.values(state.progress).forEach(p=>{ if(p.completed && p.completedAt) s.add(p.completedAt); });
  return s;
}
function currentStreak(){
  const dates = completedDatesSet();
  let streak = 0; let cursor = new Date();
  while(dates.has(dateKey(cursor))){ streak++; cursor.setDate(cursor.getDate()-1); }
  return streak;
}
function totalCompleted(){ return Object.values(state.progress).filter(p=>p.completed).length; }

/* ---------- Next capsule (continuar) ---------- */
function findNext(){
  for(let m=0;m<PILLARS.length;m++){
    if(PILLARS[m].locked) continue;
    for(let w=0; w<PILLARS[m].weeks.length; w++){
      for(let d=0; d<PILLARS[m].weeks[w].days.length; d++){
        const id = dayId(m,w,d);
        if(!(state.progress[id] && state.progress[id].completed)) return {m,w,d,id};
      }
    }
  }
  return null;
}

/* ---------- Rendering ---------- */
function render(){
  const app = document.getElementById('app');
  if(view.type==='home') app.innerHTML = renderHome();
  else if(view.type==='pillar') app.innerHTML = renderPillar(view.m);
  else if(view.type==='week') app.innerHTML = renderWeek(view.m, view.w);
  bindEvents();
}

function renderHome(){
  const next = findNext();
  const streak = currentStreak();
  let html = `
    <header>
      <div>
        <div class="eyebrow">DEVOCIONAL DIARIO</div>
        <h1>365 Cápsulas<br>de Vida</h1>
        <div class="subtitle">"Cada día, un paso más cerca de quien Dios te llama a ser."</div>
      </div>
      <button class="theme-btn" id="themeToggle">${state.settings.dark?'☀️':'🌙'}</button>
    </header>
    <div class="streak-pill">🔥 ${streak} día${streak===1?'':'s'} de racha · ${totalCompleted()} cápsulas completadas</div>
  `;
  if(next){
    const d = getDay(next.m, next.w, next.d);
    const pillar = PILLARS[next.m];
    html += `
      <div class="continue-card" data-goto="${next.m}|${next.w}|${next.d}">
        <div class="continue-eyebrow">${pillar.icon} ${pillar.name} · ${PILLARS[next.m].weeks[next.w].title}</div>
        <div class="continue-title">${d.title}</div>
        <div class="continue-sub">Cápsula ${next.d+1} de 7 esta semana</div>
        <button class="continue-btn">Abrir cápsula de hoy</button>
      </div>`;
  } else {
    html += `<div class="continue-card"><div class="continue-title">¡Completaste todo el contenido disponible! 🎉</div><div class="continue-sub">Pronto se habilitan más meses.</div></div>`;
  }

  html += `<div class="section-head"><div class="section-title">Pilares del año</div><div class="section-sub">12 meses</div></div>`;
  html += `<div class="pillar-grid">`;
  PILLARS.forEach(p=>{
    if(p.locked){
      html += `<div class="pillar-card locked"><div class="lock-badge">🔒</div><div class="pillar-icon">${p.icon}</div><div class="pillar-month">${p.monthLabel}</div><div class="pillar-name">${p.name}</div><div class="pillar-progress">Próximamente</div></div>`;
    } else {
      const totalDays = p.weeks.reduce((s,w)=>s+w.days.length,0);
      let done = 0;
      p.weeks.forEach((w,wi)=>w.days.forEach((_,di)=>{ const id=dayId(p.id,wi,di); if(state.progress[id]&&state.progress[id].completed) done++; }));
      html += `<div class="pillar-card" data-pillar="${p.id}"><div class="pillar-icon">${p.icon}</div><div class="pillar-month">${p.monthLabel}</div><div class="pillar-name">${p.name}</div><div class="pillar-progress">${done}/${totalDays} completadas</div></div>`;
    }
  });
  html += `</div>`;

  html += `<div class="section-head"><div class="section-title">Mis versículos favoritos</div><div class="section-sub">${state.favorites.length}</div></div>`;
  if(state.favorites.length===0){
    html += `<div class="empty">Toca la estrella dentro de una cápsula para guardar aquí los pasajes que más te marquen.</div>`;
  } else {
    html += `<div class="fav-list">` + state.favorites.map(id=>{
      const [m,w,d] = id.match(/m(\d+)-w(\d+)-d(\d+)/).slice(1).map(Number);
      const day = getDay(m,w,d);
      return `<div class="fav-item" data-goto="${m}|${w}|${d}"><div class="fav-item-title">★ ${day.title}</div><div class="fav-item-ref">${day.verseRef}</div></div>`;
    }).join('') + `</div>`;
  }

  html += `
    <div class="section-head"><div class="section-title">Respaldo</div><div class="section-sub"></div></div>
    <div class="backup-card">
      <div class="backup-row">
        <button class="btn-secondary" id="exportBtn">Exportar copia</button>
        <button class="btn-secondary" id="importBtn">Importar copia</button>
        <input type="file" id="importFile" accept="application/json" style="display:none;">
      </div>
      <div class="backup-hint">Todo vive solo en este dispositivo. Exporta un archivo de respaldo de vez en cuando para no perder tu progreso y tus reflexiones.</div>
    </div>`;
  return html;
}

function renderPillar(m){
  const p = PILLARS[m];
  let html = `<button class="back-btn" data-back="home">‹ Volver a pilares</button>
    <div class="eyebrow">${p.monthLabel}</div>
    <h1 style="font-size:24px;">${p.icon} ${p.name}</h1>
    <div class="subtitle">4 semanas para trabajar este pilar en profundidad</div>
    <div class="week-list">`;
  p.weeks.forEach((w, wi)=>{
    let done = 0; w.days.forEach((_,di)=>{ const id=dayId(m,wi,di); if(state.progress[id]&&state.progress[id].completed) done++; });
    html += `<div class="week-card" data-week="${wi}">
      <div><div class="week-card-title">Semana ${wi+1}: ${w.title}</div><div class="week-card-sub">${done}/${w.days.length} cápsulas completadas</div></div>
      <div style="font-size:18px; color:var(--ink-soft);">›</div>
    </div>`;
  });
  html += `</div>`;
  return html;
}

function renderWeek(m, w){
  const pillar = PILLARS[m];
  const week = pillar.weeks[w];
  let html = `<button class="back-btn" data-back="pillar" data-m="${m}">‹ Volver a ${pillar.name}</button>
    <div class="eyebrow">SEMANA ${w+1}</div>
    <h1 style="font-size:22px;">${week.title}</h1>
    <div class="subtitle">${pillar.icon} ${pillar.name}</div>
    <div class="day-list">`;
  week.days.forEach((day, di)=>{
    const id = dayId(m,w,di);
    const done = state.progress[id] && state.progress[id].completed;
    const fav = state.favorites.includes(id);
    html += `<div class="day-card" data-day="${di}">
      <div class="day-check ${done?'done':''}">${done?'✓':''}</div>
      <div style="flex:1;"><div class="day-card-title">Día ${di+1}: ${day.title}${fav?' <span class=\"fav-star\">★</span>':''}</div><div class="day-card-sub">${day.verseRef}</div></div>
      <div style="font-size:18px; color:var(--ink-soft);">›</div>
    </div>`;
  });
  html += `</div>`;
  return html;
}

/* ---------- Event binding ---------- */
function bindEvents(){
  const app = document.getElementById('app');
  const themeBtn = document.getElementById('themeToggle');
  if(themeBtn) themeBtn.addEventListener('click', ()=>{ state.settings.dark=!state.settings.dark; applyTheme(); saveState(); });

  app.querySelectorAll('[data-pillar]').forEach(el=>{
    el.addEventListener('click', ()=>{ view = {type:'pillar', m:parseInt(el.dataset.pillar)}; render(); window.scrollTo(0,0); });
  });
  app.querySelectorAll('[data-week]').forEach(el=>{
    el.addEventListener('click', ()=>{ view = {type:'week', m:view.m, w:parseInt(el.dataset.week)}; render(); window.scrollTo(0,0); });
  });
  app.querySelectorAll('[data-day]').forEach(el=>{
    el.addEventListener('click', ()=> openCapsule(view.m, view.w, parseInt(el.dataset.day)));
  });
  app.querySelectorAll('[data-back]').forEach(el=>{
    el.addEventListener('click', ()=>{
      if(el.dataset.back==='home'){ view={type:'home'}; }
      else if(el.dataset.back==='pillar'){ view={type:'pillar', m:parseInt(el.dataset.m)}; }
      render(); window.scrollTo(0,0);
    });
  });
  const continueCard = app.querySelector('.continue-card[data-goto]');
  if(continueCard){
    continueCard.addEventListener('click', ()=>{
      const [m,w,d] = continueCard.dataset.goto.split('|').map(Number);
      openCapsule(m,w,d);
    });
  }
  app.querySelectorAll('.fav-item[data-goto]').forEach(el=>{
    el.addEventListener('click', ()=>{
      const [m,w,d] = el.dataset.goto.split('|').map(Number);
      openCapsule(m,w,d);
    });
  });
  const exportBtn = document.getElementById('exportBtn');
  if(exportBtn) exportBtn.addEventListener('click', exportBackup);
  const importBtn = document.getElementById('importBtn');
  if(importBtn) importBtn.addEventListener('click', ()=> document.getElementById('importFile').click());
  const importFile = document.getElementById('importFile');
  if(importFile) importFile.addEventListener('change', handleImportFile);
}

/* ---------- Capsule modal ---------- */
let capsuleCtx = null;
function openCapsule(m,w,d){
  const day = getDay(m,w,d);
  const id = dayId(m,w,d);
  capsuleCtx = {m,w,d,id};
  if(!state.progress[id]) state.progress[id] = {completed:false, completedAt:null, answers:{}};
  const p = state.progress[id];
  const isFav = state.favorites.includes(id);

  const questionsHtml = day.questions.map((q,qi)=>`
    <div class="q-block">
      <div class="q-label"><span class="q-num">${qi+1}</span>${q}</div>
      <textarea data-qidx="${qi}" placeholder="Escribe tu respuesta...">${p.answers[qi]||''}</textarea>
    </div>`).join('');

  document.getElementById('capsuleSheet').innerHTML = `
    <div class="capsule-top">
      <button class="capsule-close" id="capsuleCloseBtn">✕</button>
      <button class="capsule-fav ${isFav?'active':''}" id="capsuleFavBtn">★</button>
    </div>
    <div class="capsule-body">
      <div class="capsule-eyebrow">${PILLARS[m].icon} ${PILLARS[m].name} · Semana ${w+1} · Día ${d+1}</div>
      <div class="capsule-title">${day.title}</div>
      <div class="verse-card"><div class="verse-ref">${day.verseRef}</div><div class="verse-text">${day.versePara}</div></div>
      <div class="reflection-text">${day.reflection}</div>
      <div class="quote-strip"><div class="quote-strip-text">"${day.quote.text}"</div><div class="quote-strip-author">— ${day.quote.author}</div></div>
      ${questionsHtml}
      <div class="capsule-actions">
        <button class="btn-complete ${p.completed?'done':''}" id="completeBtn">${p.completed?'✓ Completada hoy':'Marcar como completada'}</button>
        <button class="btn-share" id="shareBtn">⤴</button>
      </div>
      <span class="save-note" id="capsuleSaved"></span>
    </div>
  `;
  document.getElementById('capsuleOverlay').classList.add('show');
  document.getElementById('capsuleSheet').scrollTop = 0;

  document.getElementById('capsuleCloseBtn').addEventListener('click', closeCapsule);
  document.getElementById('capsuleFavBtn').addEventListener('click', toggleFavorite);
  document.getElementById('completeBtn').addEventListener('click', markComplete);
  document.getElementById('shareBtn').addEventListener('click', shareCapsule);

  let saveTimer = null;
  document.querySelectorAll('#capsuleSheet textarea').forEach(ta=>{
    ta.addEventListener('input', e=>{
      const qi = e.target.dataset.qidx;
      state.progress[id].answers[qi] = e.target.value;
      document.getElementById('capsuleSaved').textContent = 'Guardando…';
      clearTimeout(saveTimer);
      saveTimer = setTimeout(()=>{
        saveState();
        document.getElementById('capsuleSaved').textContent = 'Guardado ✓';
        setTimeout(()=>{ const el=document.getElementById('capsuleSaved'); if(el) el.textContent=''; }, 1400);
      }, 700);
    });
  });
}
function closeCapsule(){ document.getElementById('capsuleOverlay').classList.remove('show'); capsuleCtx=null; render(); }
function toggleFavorite(){
  if(!capsuleCtx) return;
  const id = capsuleCtx.id;
  const idx = state.favorites.indexOf(id);
  if(idx>=0){ state.favorites.splice(idx,1); } else { state.favorites.push(id); }
  saveState();
  document.getElementById('capsuleFavBtn').classList.toggle('active', state.favorites.includes(id));
  showToast(idx>=0 ? 'Quitado de favoritos' : '★ Guardado en favoritos');
}
function markComplete(){
  if(!capsuleCtx) return;
  const p = state.progress[capsuleCtx.id];
  const wasCompleted = p.completed;
  p.completed = !wasCompleted;
  p.completedAt = p.completed ? todayKey() : null;
  state.lastOpened = capsuleCtx.id;
  saveState();
  const btn = document.getElementById('completeBtn');
  btn.textContent = p.completed ? '✓ Completada hoy' : 'Marcar como completada';
  btn.classList.toggle('done', p.completed);
  if(p.completed){ showToast('🕊️ Cápsula completada — ¡sigue así!', true); }
}
function shareCapsule(){
  if(!capsuleCtx) return;
  const day = getDay(capsuleCtx.m, capsuleCtx.w, capsuleCtx.d);
  const canvas = document.getElementById('shareCanvas');
  const ctx = canvas.getContext('2d');
